# Production-like stack (docker-compose.prod.yml) and the reference list of
# production values (docs/PRODUCTION_CONFIGURATION.md). Copy to .env.production
# (git-ignored) and replace EVERY value. The API refuses to start with
# placeholders, weak secrets, http URLs or open Redis.
#
# Generate secrets with:  openssl rand -base64 48

POSTGRES_USER=samadhaan
POSTGRES_DB=samadhaan
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 32+ characters each, random. Never reuse between environments.
JWT_ACCESS_SECRET=
# Shared secret API -> AI service (sent as x-internal-token).
AI_SERVICE_TOKEN=

# Public origin of the web app (https). CORS and media URLs derive from it.
PUBLIC_WEB_URL=https://localhost
SITE_ADDRESS=localhost

# AI provider (server-side only). Without a key, analysis and answers are
# reported as unavailable; reporting and collaboration keep working.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# Storage: s3 (recommended) or local on a single host with a backed-up volume.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Non-AWS providers only (R2, MinIO): https endpoint.
STORAGE_ENDPOINT=
# Only with STORAGE_PROVIDER=local, acknowledging single-instance storage.
STORAGE_ALLOW_LOCAL_IN_PRODUCTION=false

# Prometheus scrape token for GET /api/v1/metrics (32+ chars). Empty = disabled.
METRICS_TOKEN=

LOG_LEVEL=info
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
