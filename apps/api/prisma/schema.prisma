// Samadhaan database schema.
//
// Organised as: identity -> organisations -> problem -> problem satellites ->
// platform. `Problem` is the central entity; everything downstream attaches to
// it rather than extending it, so a new capability adds a table instead of
// reshaping the one every query touches.
//
// Conventions used throughout:
//   - UUID primary keys; `publicId` carries the human-readable identifier
//   - `@db.Timestamptz(3)` everywhere, so instants are unambiguous
//   - soft delete (`deletedAt`) on anything with historical value
//   - `onDelete: Restrict` on authored content, `Cascade` only on parts that
//     have no meaning without their parent
//   - enums for controlled vocabularies, JSON only for genuinely dynamic data
//
// See docs/DATABASE.md for the ERD, lifecycle and index rationale.

generator client {
  // Prisma 7 generator. Emits an ESM client, matching the API's module setup.
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // postgresqlExtensions unlocks `extensions` on the datasource below.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 7 reads the connection URL from prisma.config.ts, not from here.
  //
  // Extensions are declared here so `prisma migrate` emits the CREATE
  // EXTENSION statements and keeps them in the migration history. This list
  // must stay identical to infrastructure/database/init.sql, otherwise Prisma
  // reports schema drift against a Docker-provisioned database.
  //   postgis  - geographic problem search and clustering
  //   vector   - semantic duplicate detection and RAG retrieval
  //   pg_trgm  - fuzzy text matching on problem titles
  extensions = [postgis, vector, pg_trgm]
}

// ===========================================================================
// IDENTITY
// ===========================================================================

/// Platform role. Drives authorisation and which dashboards a user can reach.
enum UserRole {
  CITIZEN
  NGO
  UNIVERSITY
  INDUSTRY
  GOVERNMENT
  ADMIN
}

/// Account lifecycle. New accounts start PENDING_VERIFICATION; organisation and
/// government accounts additionally require manual approval before ACTIVE.
enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email        String  @unique
  /// Argon2id hash. Null for accounts created through a future OAuth provider.
  passwordHash String?

  /// Single field rather than first/last: many Indian names do not split
  /// cleanly in two, and nothing in the product needs the halves separately.
  fullName    String
  /// Public handle used in mentions and on the leaderboard.
  displayName String? @unique
  phone       String? @unique
  avatarUrl   String?
  /// Short self-description shown on the public profile.
  bio         String?

  // --- Location -----------------------------------------------------------
  // Coarse only: city/state, never a precise address. A civic platform shows
  // "reports problems in Gurugram", which builds local credibility, without
  // publishing where a reporter lives. No coordinates on `User` for the same
  // reason — problems carry precise geography, people do not.
  city       String?
  state      String?
  country    String? @default("India")
  postalCode String?

  role   UserRole   @default(CITIZEN)
  status UserStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)

  sessions             Session[]
  organizationMembers  OrganizationMember[]
  expertiseAdded       OrganizationExpertise[]     @relation("ExpertiseAddedBy")
  reportedProblems     Problem[]                   @relation("ProblemReporter")
  votes                ProblemVote[]
  follows              ProblemFollow[]
  comments             ProblemComment[]
  suggestions          ProblemSuggestion[]
  reviewedSuggestions  ProblemSuggestion[]         @relation("SuggestionReviewer")
  duplicateReviews     ProblemDuplicateCandidate[] @relation("DuplicateReviewer")
  auditEvents          AuditLog[]
  internalNotes        ProblemInternalNote[]       @relation("InternalNoteAuthor")
  allocationsMade      ProblemAllocation[]         @relation("AllocationAllocatedBy")
  allocationResponses  ProblemAllocation[]         @relation("AllocationRespondedBy")
  allocationsCancelled ProblemAllocation[]         @relation("AllocationCancelledBy")
  roomsClosed          ResolutionRoom[]            @relation("RoomClosedBy")
  roomMessages         ResolutionMessage[]
  roomMentions         ResolutionMessageMention[]
  roomAttachments      ResolutionAttachment[]
  roomEvents           ResolutionRoomEvent[]
  roomReads            ResolutionRoomRead[]
  projectsCreated      ResolutionProject[]         @relation("ProjectCreatedBy")
  tasksCreated         ResolutionTask[]            @relation("TaskCreatedBy")
  tasksAssigned        ResolutionTask[]            @relation("TaskAssignee")
  tasksCompleted       ResolutionTask[]            @relation("TaskCompletedBy")
  milestonesCreated    ResolutionMilestone[]       @relation("MilestoneCreatedBy")
  milestonesCompleted  ResolutionMilestone[]       @relation("MilestoneCompletedBy")
  coordinatorRefreshes ProjectAIInsight[]
  coordinatorAnswers   CoordinatorQuestion[]       @relation("QuestionAnsweredBy")
  coordinatorDismissed CoordinatorQuestion[]       @relation("QuestionDismissedBy")
  knowledgeSources     KnowledgeSource[]
  knowledgeAnswers     KnowledgeAnswer[]
  projectUpdates       ProjectUpdate[]
  notifications        Notification[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  /// Soft delete. Every query filters on `deletedAt: null` so a removed account
  /// keeps its authored problems and comments referentially intact.
  deletedAt DateTime? @db.Timestamptz(3)

  /// Serves "active users of role X" — organisation discovery runs it often.
  @@index([role, status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

/// A refresh-token session — one row per signed-in device.
///
/// Refresh tokens are opaque random values, never JWTs, and only their SHA-256
/// digest is stored. A database leak therefore yields nothing usable: an
/// attacker cannot reverse a digest into a token the API will accept.
///
/// This table is what makes logout real. Access tokens are stateless JWTs and
/// cannot be recalled, so they are kept short-lived; revocation happens here,
/// by deleting the session the refresh token points at.
model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token. Unique so rotation cannot collide.
  /// SHA-256 rather than Argon2: the token is already 256 bits of entropy, so
  /// there is nothing to brute-force, and this is verified on every refresh.
  tokenHash String @unique

  /// Shown in a future "your devices" screen and used to spot session theft.
  userAgent String?
  ipAddress String?

  expiresAt DateTime  @db.Timestamptz(3)
  /// Set when the session is revoked — by logout, by a password change, or by
  /// refresh-token reuse detection. Kept rather than deleted so the audit
  /// trail survives; every lookup filters on it.
  revokedAt DateTime? @db.Timestamptz(3)

  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ===========================================================================
// ORGANISATIONS
// ===========================================================================

/// What kind of body an organisation is. Separate from `UserRole`: a user's
/// role says what they may do on the platform, this says what the organisation
/// *is*. A government department is an organisation too, which is why
/// GOVERNMENT appears in both.
enum OrganizationType {
  NGO
  UNIVERSITY
  INDUSTRY
  GOVERNMENT
}

/// Whether Samadhaan has confirmed the organisation is genuine.
///
/// Unverified organisations can exist but must not be allocated problems —
/// allocation is the point at which public work is handed over, and that
/// requires a checked identity.
/// What kind of public body a GOVERNMENT organisation is (Prompt 15).
enum JurisdictionType {
  MUNICIPAL_CORPORATION
  MUNICIPALITY
  DISTRICT_ADMINISTRATION
  URBAN_LOCAL_BODY
  GOVERNMENT_DEPARTMENT
  PUBLIC_AUTHORITY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

/// A member's authority *within* an organisation.
///
/// Deliberately distinct from `UserRole`. One user can hold different
/// membership roles in different organisations, which a single column on `User`
/// could never express.
enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

/// Membership lifecycle — invitations and removals both need a state.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

/// An NGO, university, industry partner or government department.
model Organization {
  id String @id @default(uuid()) @db.Uuid

  name String
  /// URL-safe identifier for public pages: /organizations/clean-city-foundation
  slug String @unique

  type        OrganizationType
  description String?
  logoUrl     String?
  websiteUrl  String?

  email String?
  phone String?

  // --- Registered address -------------------------------------------------
  address    String?
  city       String?
  state      String?
  country    String? @default("India")
  postalCode String?

  /// Decimal rather than float: coordinates are compared and grouped, and
  /// binary floating point makes both subtly unreliable. 9,6 gives ~11 cm.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// PostGIS point, derived from latitude/longitude by a database trigger.
  /// Prisma cannot express this type, so it is declared `Unsupported` and never
  /// written by the client — see `problems_location_sync` in the migration.
  location Unsupported("geography(Point, 4326)")?

  // --- Jurisdiction (GOVERNMENT organisations only, Prompt 15) -------------
  // Which problems a government office may review. Resolved in this order:
  // the boundary polygon if present; otherwise the listed cities; otherwise
  // the listed postal codes; otherwise nothing at all — fail closed.
  jurisdictionType        JurisdictionType?
  /// Human name of the area, e.g. "Gurugram Municipal Corporation area".
  jurisdictionName        String?
  /// PostGIS boundary. Written by raw SQL (Prisma cannot express it).
  jurisdictionBoundary    Unsupported("geography(MultiPolygon, 4326)")?
  /// Fallback when there is no boundary. Compared case-insensitively.
  jurisdictionCities      String[]                                      @default([])
  jurisdictionPostalCodes String[]                                      @default([])

  verificationStatus VerificationStatus @default(PENDING)
  /// When verification last changed, for the admin queue.
  verifiedAt         DateTime?          @db.Timestamptz(3)

  isActive Boolean @default(true)

  members              OrganizationMember[]
  internalNotes        ProblemInternalNote[]
  suggestions          ProblemSuggestion[]
  allocationsReceived  ProblemAllocation[]        @relation("AllocatedOrganization")
  allocationsMade      ProblemAllocation[]        @relation("AllocatingOffice")
  roomsAsGovernment    ResolutionRoom[]           @relation("RoomGovernment")
  roomsAsAssigned      ResolutionRoom[]           @relation("RoomOrganization")
  roomMessages         ResolutionMessage[]
  projectsAsGovernment ResolutionProject[]        @relation("ProjectGovernment")
  projectsAsAssigned   ResolutionProject[]        @relation("ProjectOrganization")
  knowledgeSources     KnowledgeSource[]
  projectUpdates       ProjectUpdate[]
  expertise            OrganizationExpertise[]
  embeddings           OrganizationEmbedding[]
  matches              OrganizationProblemMatch[]

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  /// Discovery filters by type and verification together.
  @@index([type, verificationStatus])
  /// The admin verification queue.
  @@index([verificationStatus])
  /// Regional listings and analytics.
  @@index([state, city])
  @@index([deletedAt])
  @@index([location], map: "organizations_location_gist", type: Gist)
  @@index([jurisdictionBoundary], map: "organizations_jurisdiction_gist", type: Gist)
  @@map("organizations")
}

/// Links a user to an organisation.
///
/// A join table rather than a column on `User`, because membership is
/// many-to-many: a researcher may belong to a university and advise an NGO, and
/// each membership carries its own role and status.
model OrganizationMember {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Restrict, not Cascade: removing a person from the platform must not
  /// silently rewrite an organisation's membership history.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  membershipRole OrganizationMemberRole @default(MEMBER)
  status         MembershipStatus       @default(INVITED)

  /// Set when the invitation is accepted; null while still INVITED.
  joinedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One membership per person per organisation. Enforced by the database, so
  /// a duplicate invitation cannot slip through a race between two requests.
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_members")
}

/// How capable an organisation is in one area.
///
/// Ordered from least to most. The recommendation engine weights matches by
/// this, so an organisation that has resolved fifty drainage problems outranks
/// one that has merely declared an interest.
enum ExpertiseLevel {
  INTERESTED
  EXPERIENCED
  SPECIALIST
}

/// An area an organisation works in.
///
/// A row per area, not a comma-separated string, because this is the input to
/// organisation matching. A free-text list cannot be indexed, cannot be joined
/// against a problem's category, and drifts the moment two people spell
/// "waste management" differently.
///
/// `category` reuses `ProblemCategory` deliberately: matching an organisation
/// to a problem is a comparison between the two, and a parallel taxonomy would
/// need a translation table that is wrong the first time either side changes.
/// Areas with no civic-problem equivalent — urban planning, education — are
/// expressed as `subcategory` under the closest category rather than by forking
/// the enum.
model OrganizationExpertise {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category    ProblemCategory
  /// Optional refinement, e.g. "stormwater drainage" under DRAINAGE.
  subcategory String?

  level ExpertiseLevel @default(EXPERIENCED)

  /// Who declared it. SetNull so the claim survives the person leaving.
  addedById String? @db.Uuid
  addedBy   User?   @relation("ExpertiseAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One claim per category per organisation. Refinements live in
  /// `subcategory`; a second row for the same category would make "which level
  /// applies here?" ambiguous for the matcher.
  @@unique([organizationId, category])
  /// The matcher's primary lookup: "who works on DRAINAGE, best first".
  @@index([category, level])
  @@index([organizationId])
  @@map("organization_expertise")
}

// ===========================================================================
// PROBLEM — the central domain entity
// ===========================================================================

/// The full lifecycle a report moves through.
///
/// Ordered as it progresses. DUPLICATE and REJECTED are terminal side exits
/// rather than stages; ARCHIVED removes a resolved problem from active views
/// without deleting the civic record.
enum ProblemStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  IN_PROGRESS
  RESOLVED
  REJECTED
  DUPLICATE
  ARCHIVED
}

/// How bad the problem is. Paired with urgency, which is a different question.
enum ProblemSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// How soon it must be dealt with.
///
/// Distinct from severity on purpose: a collapsed footpath is severe but not
/// urgent at 3am; a live electrical cable is both. Collapsing them into one
/// number is what makes triage queues wrong.
enum ProblemUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Controlled taxonomy for problem classification.
///
/// An enum rather than a lookup table, deliberately: the AI classifier must
/// emit a closed set, and the database checking that is worth more than the
/// flexibility of rows. If municipalities later need their own categories, the
/// migration path is a `categories` table with this enum seeded into it and
/// `Problem.categoryId` alongside — documented in docs/DATABASE.md.
enum ProblemCategory {
  ROADS
  POTHOLES
  STREETLIGHTS
  WATER
  DRAINAGE
  SANITATION
  GARBAGE
  TRAFFIC
  PUBLIC_SAFETY
  POLLUTION
  ELECTRICITY
  PUBLIC_TRANSPORT
  PARKS
  PUBLIC_INFRASTRUCTURE
  OTHER
}

/// A civic problem reported by a citizen.
///
/// The centre of the domain. Everything downstream — AI analysis, duplicate
/// detection, votes, comments, allocation, resolution — attaches to this row
/// through its own table rather than widening it, so adding a capability never
/// means migrating the table every query already touches.
model Problem {
  id String @id @default(uuid()) @db.Uuid

  /// Human-readable reference such as `SAM-1023`, shown in the UI and quoted
  /// in correspondence. Generated by a PostgreSQL sequence default, so two
  /// concurrent reports cannot collide — see the migration.
  /// Not the primary key: a guessable sequential id in a URL leaks total
  /// volume and invites enumeration, so the UUID stays authoritative.
  /// `dbgenerated("")` is Prisma's escape hatch for a default it cannot
  /// express: the client omits the column on insert and PostgreSQL supplies
  /// `'SAM-' || nextval(...)`. Writing the expression out instead would make
  /// the field required in the create input, which defeats the point.
  publicId String @unique @default(dbgenerated())

  /// Restrict: a citizen leaving the platform must not erase the civic record
  /// they created. Users are soft-deleted; their reports survive.
  reporterId String @db.Uuid
  reporter   User   @relation("ProblemReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  title       String
  description String

  /// Human-assigned at report time; the AI's opinion lives in
  /// `ProblemAiAnalysis`, so the two are never confused.
  category    ProblemCategory
  /// Free text within a category, e.g. "blocked stormwater drain".
  subcategory String?

  status   ProblemStatus   @default(DRAFT)
  severity ProblemSeverity @default(MEDIUM)
  urgency  ProblemUrgency  @default(MEDIUM)

  /// Composite triage score, 0–100. Maintained by the priority system in a
  /// later milestone; 0 until then. Constrained non-negative in the database.
  priorityScore Decimal @default(0) @db.Decimal(6, 2)

  // --- Location -----------------------------------------------------------
  address    String?
  city       String?
  state      String?
  country    String? @default("India")
  postalCode String?

  /// Required: a civic problem without a place cannot be routed to anyone.
  /// Range-checked in the database (-90..90 / -180..180).
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  /// PostGIS point maintained by a trigger from latitude/longitude, with a
  /// GiST index. Radius and clustering queries use this; the decimal columns
  /// remain the writable source of truth. See docs/DATABASE.md.
  location Unsupported("geography(Point, 4326)")?

  /// Reported GPS accuracy in metres, when the device supplied it. Duplicate
  /// detection widens its match radius when accuracy is poor.
  locationAccuracyM Int?

  // --- Denormalised counters ---------------------------------------------
  /// Maintained transactionally alongside the vote/comment rows. The feed sorts
  /// and filters on these, and counting rows per problem per request does not
  /// survive contact with a real feed.
  voteCount    Int @default(0)
  commentCount Int @default(0)
  followCount  Int @default(0)

  /// When the most recent comment was posted. Drives "recently discussed" in
  /// community discovery: ordering problems by their latest comment would
  /// otherwise mean aggregating every comment row on every feed request.
  /// Maintained in the same transaction as the comment insert. Not rewound when
  /// a comment is removed — the discussion still happened.
  lastCommentAt DateTime? @db.Timestamptz(3)

  // --- Relations ----------------------------------------------------------
  images        ProblemImage[]
  aiAnalyses    ProblemAiAnalysis[]
  embeddings    ProblemEmbedding[]
  orgMatches    OrganizationProblemMatch[]
  internalNotes ProblemInternalNote[]
  votes         ProblemVote[]
  follows       ProblemFollow[]
  comments      ProblemComment[]
  suggestions   ProblemSuggestion[]

  /// Pairs where this problem is the newer report being checked.
  duplicateCandidates ProblemDuplicateCandidate[] @relation("DuplicateSource")
  /// Pairs where this problem is the older one being matched against.
  duplicateMatches    ProblemDuplicateCandidate[] @relation("DuplicateTarget")

  /// Set when this problem is confirmed to duplicate an earlier one. The
  /// canonical problem accumulates the supporters of everything merged into it.
  duplicateOfId String?   @db.Uuid
  duplicateOf   Problem?  @relation("ProblemDuplicates", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates    Problem[] @relation("ProblemDuplicates")

  submittedAt DateTime? @db.Timestamptz(3)
  resolvedAt  DateTime? @db.Timestamptz(3)

  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?           @db.Timestamptz(3)
  problemAllocations ProblemAllocation[]
  resolutionRooms    ResolutionRoom[]
  resolutionProjects ResolutionProject[]

  /// The default feed: newest active problems first.
  @@index([status, createdAt])
  /// Organisation discovery filters by category, then status.
  @@index([category, status])
  /// Government triage queue ordering.
  @@index([status, priorityScore])
  /// "My problems".
  @@index([reporterId, createdAt])
  /// Regional dashboards and analytics.
  @@index([state, city, status])
  @@index([severity, urgency])
  @@index([deletedAt])
  @@index([duplicateOfId])
  /// "Recently discussed" community discovery.
  @@index([lastCommentAt(sort: Desc)])
  /// Radius search and clustering. GiST, because a B-tree on lat/lng cannot
  /// answer "within 2 km of here" — declared here so Prisma owns it and a
  /// later `migrate dev` does not propose dropping it.
  @@index([location], map: "problems_location_gist", type: Gist)
  /// Fuzzy title matching, complementing vector search during deduplication.
  @@index([title(ops: raw("gin_trgm_ops"))], map: "problems_title_trgm", type: Gin)
  @@map("problems")
}

// ===========================================================================
// PROBLEM SATELLITES — media, AI, duplicates
// ===========================================================================

/// What a photo is evidence of.
///
/// Distinguishing these now is what lets resolution verification later compare
/// a BEFORE against an AFTER; retrofitting the distinction onto untyped images
/// would mean guessing from timestamps.
enum ProblemImageKind {
  BEFORE
  PROGRESS
  AFTER
  EVIDENCE
}

/// A photo attached to a problem.
///
/// Only metadata and an object-store key live here. Binary data in PostgreSQL
/// bloats the table, defeats its cache, and makes every backup enormous — the
/// bytes belong in object storage.
model ProblemImage {
  id String @id @default(uuid()) @db.Uuid

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// Object-store key — the authoritative reference.
  storageKey String  @unique
  /// Resolved public or signed URL. Derived from `storageKey`, cached here to
  /// avoid re-signing on every feed render; may be regenerated at any time.
  url        String?

  originalFileName String?
  mimeType         String
  /// Bytes. Constrained positive in the database.
  fileSize         Int
  width            Int?
  height           Int?

  kind      ProblemImageKind @default(BEFORE)
  /// Display order within the problem's gallery.
  sortOrder Int              @default(0)
  /// The card thumbnail. At most one per problem, enforced by a partial unique
  /// index in the migration.
  isPrimary Boolean          @default(false)

  /// Perceptual hash, for cheap near-identical detection before any model runs.
  perceptualHash String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([problemId, sortOrder])
  @@index([problemId, kind])
  @@map("problem_images")
}

/// Which question the model was asked.
enum AnalysisType {
  INITIAL_ANALYSIS
  REANALYSIS
  DUPLICATE_ANALYSIS
  SEVERITY_ANALYSIS
  VERIFICATION_ANALYSIS
  /// One organisation-matching run for the problem (Prompt 14). The job's
  /// lifecycle and provenance live here, like every other AI job.
  ORGANIZATION_MATCHING
}

/// Lifecycle of an analysis job.
enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// One AI analysis of one problem.
///
/// A separate table, not columns on `Problem`, for three reasons: analyses are
/// re-run and must not overwrite their predecessors; every result carries its
/// own confidence and model version, which a flattened column cannot; and a
/// machine opinion must stay visibly distinct from the human-entered values on
/// `Problem`, because a reviewer has to be able to disagree with it.
///
/// Together these rows are also the training set for any future custom model.
model ProblemAiAnalysis {
  id String @id @default(uuid()) @db.Uuid

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// Recorded so a regression can be traced to the model that caused it, and
  /// so results from different models are never silently compared.
  modelName    String
  modelVersion String

  analysisType AnalysisType

  // --- Findings. Null until the job completes. ----------------------------
  category      ProblemCategory?
  subcategory   String?
  severity      ProblemSeverity?
  urgency       ProblemUrgency?
  /// 0–10 with one decimal, the finer-grained score behind the severity band.
  severityScore Decimal?         @db.Decimal(4, 2)
  /// One or two plain sentences, shown to citizens.
  summary       String?
  /// 0–1. Range-checked in the database. Always displayed with the finding.
  confidence    Decimal?         @db.Decimal(5, 4)

  /// The provider's full response. JSONB because its shape is genuinely the
  /// model's to decide and changes between versions — the columns above are the
  /// stable subset we commit to.
  rawResult Json? @db.JsonB

  processingStatus ProcessingStatus @default(PENDING)
  /// Operator-facing failure reason. Never shown to citizens.
  errorMessage     String?
  /// Inference wall-clock, for cost and latency monitoring.
  processingMs     Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// "Latest analysis of this kind for this problem" — the common read.
  @@index([problemId, analysisType, createdAt])
  /// The job queue.
  @@index([processingStatus, createdAt])
  @@map("problem_ai_analyses")
}

/// Which representation a vector encodes.
enum EmbeddingType {
  TEXT
  IMAGE
  MULTIMODAL
}

/// A vector representation of a problem, for semantic search and duplicate
/// detection.
///
/// **Fixed dimension — a deliberate trade-off.** pgvector can only build an
/// HNSW index on a column of declared width, and approximate nearest-neighbour
/// search is the entire point of this table, so the column is `vector(384)`:
/// the native width of the configured text encoder
/// (`sentence-transformers/all-MiniLM-L6-v2`).
///
/// Padding a narrower model up to a wider column was rejected — it wastes index
/// space and makes a dimension mismatch *look* fine. Matching the column to the
/// model keeps the two honest, at the cost of a migration whenever the model
/// changes. That migration is documented in docs/DATABASE.md §6 and is cheap:
/// re-embedding is idempotent and the corpus can be rebuilt from the problems.
///
/// The consequence to plan for: a 512-dimensional image encoder such as CLIP
/// does not fit. When image embeddings land they get a second table at their
/// native width rather than being projected into this one — see
/// docs/ML_DUPLICATE_DETECTION.md. `dimensions` is recorded on every row so a
/// mismatch is detectable rather than silent, and the API refuses to compare
/// vectors whose `modelName` differs.
model ProblemEmbedding {
  id String @id @default(uuid()) @db.Uuid

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  embeddingType EmbeddingType
  modelName     String
  modelVersion  String
  /// Actual width of the stored vector. Guards against a model swap quietly
  /// writing vectors that are no longer comparable with the existing corpus.
  dimensions    Int           @default(384)

  /// pgvector column. Prisma cannot express the type, so it is `Unsupported`
  /// and written by raw SQL from the AI service — see docs/DATABASE.md.
  embedding Unsupported("vector(384)")?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// One current embedding per problem per type per model. Re-embedding with
  /// the same model replaces the row rather than accumulating duplicates.
  @@unique([problemId, embeddingType, modelName])
  @@index([embeddingType])
  @@map("problem_embeddings")
}

/// Where a candidate pair stands.
/// An organisation's profile in the embedding space (Prompt 14).
///
/// Mirrors `ProblemEmbedding`: one current vector per organisation per model,
/// written by raw SQL because Prisma cannot express `vector`. `sourceHash` is
/// a SHA-256 of the exact text that was encoded, so an unchanged profile is
/// never re-embedded and a changed one always is.
model OrganizationEmbedding {
  id String @id @default(uuid()) @db.Uuid

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  modelName    String
  modelVersion String
  dimensions   Int    @default(384)
  /// SHA-256 of the encoded profile text. Changes iff the profile changed.
  sourceHash   String

  embedding Unsupported("vector(384)")?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, modelName])
  @@map("organization_embeddings")
}

/// Lifecycle of one organisation–problem match. Deliberately no acceptance,
/// assignment or allocation states: a match says "potentially relevant",
/// nothing more. Those workflows belong to later milestones.
enum OrganizationMatchStatus {
  /// Current output of the matching engine.
  CALCULATED
  /// An input changed; still shown until the background re-match replaces it.
  STALE
  /// The organisation marked it not relevant. Survives re-matching.
  DISMISSED
}

/// How relevant one organisation is to one problem, as computed by a specific
/// matching engine version (Prompt 14).
///
/// Every signal is stored separately so a score can always be explained and
/// audited, and so a future trained model can be compared against this
/// baseline on the same rows. Written only by the matching service — no
/// endpoint lets a client set any of these values.
model OrganizationProblemMatch {
  id String @id @default(uuid()) @db.Uuid

  problemId      String       @db.Uuid
  problem        Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // --- Signals, each 0–1. Null when the signal was unavailable. ----------
  semanticScore   Float?
  expertiseScore  Float?
  categoryScore   Float?
  geographicScore Float?
  capabilityScore Float?
  activityScore   Float?

  /// Weighted composite, 0–1. A relevance score, not a model confidence.
  finalScore Float
  /// Position among this problem's matches, 1 = most relevant.
  rank       Int

  /// Engine identity, e.g. `heuristic-baseline@1.0.0+w3f9a1c`. Includes a
  /// hash of the weights, so changing them is a new version.
  matchingVersion String
  /// The embedding model the semantic signal came from.
  modelName       String
  modelVersion    String

  status OrganizationMatchStatus @default(CALCULATED)

  /// Structured evidence: reason codes, matched expertise, distance. The UI
  /// renders explanations from this — nothing here is free text from a model.
  explanation Json @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([problemId, organizationId, matchingVersion])
  /// "Organisations for this problem, best first."
  @@index([problemId, status, finalScore(sort: Desc)])
  /// "Recommended problems for this organisation, best first."
  @@index([organizationId, status, finalScore(sort: Desc)])
  @@map("organization_problem_matches")
}

enum DuplicateStatus {
  PENDING
  LIKELY_DUPLICATE
  NOT_DUPLICATE
  CONFIRMED_DUPLICATE
  REJECTED
}

/// A suspected duplicate pair, with the signals that produced it.
///
/// **Directional, and deliberately so.** The row records "the newer problem
/// `problemId` may duplicate the older `candidateProblemId`", because merging
/// is itself directional: the older report is canonical and inherits the
/// supporters. A normalised undirected pair would lose which came first, and
/// that is exactly the fact the merge needs.
///
/// A database constraint keeps the direction honest (`problemId` must be the
/// newer row by created-at ordering is enforced in application code; the
/// constraint here prevents self-reference), and the unique pair index stops
/// the same comparison being stored twice.
///
/// Rejected candidates are kept, not deleted: without the negatives the
/// similarity thresholds cannot be tuned.
model ProblemDuplicateCandidate {
  id String @id @default(uuid()) @db.Uuid

  /// The newer problem being checked.
  problemId String  @db.Uuid
  problem   Problem @relation("DuplicateSource", fields: [problemId], references: [id], onDelete: Cascade)

  /// The older problem it may duplicate.
  candidateProblemId String  @db.Uuid
  candidateProblem   Problem @relation("DuplicateTarget", fields: [candidateProblemId], references: [id], onDelete: Cascade)

  // --- Signals, each 0–1 and range-checked in the database ----------------
  /// Cosine similarity of text embeddings.
  textSimilarity       Decimal? @db.Decimal(5, 4)
  /// Cosine similarity of image embeddings.
  imageSimilarity      Decimal? @db.Decimal(5, 4)
  /// Derived from distance, scaled by the category's expected radius.
  geographicSimilarity Decimal? @db.Decimal(5, 4)
  /// 1 when categories match, lower for related categories.
  categorySimilarity   Decimal? @db.Decimal(5, 4)
  /// Weighted combination of the above; what the thresholds are applied to.
  combinedScore        Decimal? @db.Decimal(5, 4)
  confidence           Decimal? @db.Decimal(5, 4)

  status DuplicateStatus @default(PENDING)

  /// Who confirmed or rejected the match, once a human has looked.
  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("DuplicateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One record per ordered pair.
  @@unique([problemId, candidateProblemId])
  @@index([candidateProblemId])
  /// The human review queue: highest-scoring pending pairs first.
  @@index([status, combinedScore])
  @@map("problem_duplicate_candidates")
}

// ===========================================================================
// COMMUNITY
// ===========================================================================

/// A citizen's support for a problem.
///
/// Support, not a score: there is no downvote. Civic problems are not opinions
/// to be argued down, and a negative vote would let a minority bury a report
/// that affects someone else's street.
model ProblemVote {
  id String @id @default(uuid()) @db.Uuid

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// One support per person per problem. A database constraint rather than an
  /// application check, because two concurrent taps would otherwise both pass
  /// a read-then-write test and inflate the count.
  @@unique([problemId, userId])
  @@index([userId, createdAt])
  @@map("problem_votes")
}

/// A subscription to a problem's updates.
///
/// Separate from voting: someone may want notifications about a problem without
/// publicly supporting it, and supporters may not want every update.
model ProblemFollow {
  id String @id @default(uuid()) @db.Uuid

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([problemId, userId])
  @@index([userId, createdAt])
  @@map("problem_follows")
}

/// A comment on a problem, optionally a reply to another comment.
model ProblemComment {
  id String @id @default(uuid()) @db.Uuid

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// Restrict: comments are part of the public record of a problem and must
  /// survive their author leaving. Authors are soft-deleted.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Null for a top-level comment. Self-referencing for threads.
  ///
  /// Adjacency list rather than a materialised path or nested set: Samadhaan's
  /// threads are shallow — a comment and its replies — and this is the shape
  /// that stays simple for that. Restrict on delete so a parent cannot vanish
  /// and orphan its replies; deletion is soft.
  parentCommentId String?          @db.Uuid
  parentComment   ProblemComment?  @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Restrict)
  replies         ProblemComment[] @relation("CommentThread")

  body     String
  isEdited Boolean @default(false)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  /// Soft delete so moderation leaves the thread structure intact — a removed
  /// comment renders as "removed" rather than detaching its replies.
  deletedAt DateTime? @db.Timestamptz(3)

  /// Loading a problem's thread in display order.
  @@index([problemId, createdAt])
  /// A thread's replies in reading order. Replaces a bare `parentCommentId`
  /// index, which found the replies but then had to sort them.
  @@index([parentCommentId, createdAt])
  @@index([userId, createdAt])
  @@map("problem_comments")
}

/// Where a proposed solution stands.
enum SuggestionStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

/// A proposed way to fix a problem, from a citizen or an organisation.
model ProblemSuggestion {
  id String @id @default(uuid()) @db.Uuid

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  /// Set when the author is proposing on behalf of an organisation. Null for a
  /// private citizen — which is why this is nullable rather than a second table.
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  title       String
  description String

  status SuggestionStatus @default(PENDING)

  /// The reviewer who accepted or rejected it, once decided.
  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("SuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @db.Timestamptz(3)

  /// Community endorsements, maintained alongside a future endorsement table.
  endorsementCount Int @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  /// A problem's suggestions, best-endorsed first.
  @@index([problemId, status])
  @@index([authorId, createdAt])
  @@index([organizationId])
  @@map("problem_suggestions")
}

// ===========================================================================
// PLATFORM
// ===========================================================================

/// An append-only record of consequential actions.
///
/// Samadhaan's output is a public record of civic accountability, so "who
/// changed this, when, and on what basis" has to survive independently of the
/// rows it describes. That is why `entityType`/`entityId` are loose strings
/// rather than foreign keys: the log must outlive what it references, and a
/// foreign key would either block the delete or cascade the evidence away.
///
/// Nothing writes to this table yet; the audit service arrives with the
/// workflows that need it.
// ===========================================================================
// Notifications
// ===========================================================================

/// What a notification is about. Controlled, because the client maps each to an
/// icon and a destination, and an unknown free-text type would render as
/// neither. Only events the product can actually produce today are listed;
/// later milestones (allocation, resolution, impact) add theirs with a
/// migration, alongside the code that emits them.
enum NotificationType {
  AI_ANALYSIS_COMPLETED
  AI_ANALYSIS_FAILED
  POSSIBLE_DUPLICATE_FOUND
  PROBLEM_SUPPORTED
  PROBLEM_COMMENTED
  COMMENT_REPLIED
  /// To a follower who is not the reporter.
  FOLLOWED_PROBLEM_UPDATED
  /// To the reporter.
  PROBLEM_STATUS_CHANGED
  // --- Allocation (Prompt 16) ---------------------------------------------
  /// To the allocated organisation's owners and admins.
  ALLOCATION_REQUESTED
  /// To the allocating office's officials.
  ALLOCATION_ACCEPTED
  ALLOCATION_DECLINED
  /// To the organisation whose pending allocation was withdrawn.
  ALLOCATION_CANCELLED
  // --- Resolution rooms (Prompt 17) ---------------------------------------
  /// New messages in a room, once per unread streak.
  RESOLUTION_MESSAGE
  /// Named in a message.
  RESOLUTION_MENTION
  /// The allocating office closed the room.
  RESOLUTION_ROOM_CLOSED
  // --- Projects (Prompt 18) -------------------------------------------------
  /// To the person a task was assigned to.
  PROJECT_TASK_ASSIGNED
  /// To the assignee, the day before a task is due.
  PROJECT_TASK_DUE_SOON
  /// To the task's creator, when someone else completes it.
  PROJECT_TASK_COMPLETED
  /// To every participant but the actor.
  PROJECT_MILESTONE_COMPLETED
  PROJECT_STATUS_CHANGED
  // --- AI Project Coordinator (Prompt 19) -----------------------------------
  /// Health worsened to AT_RISK/BLOCKED, or a new potential blocker.
  PROJECT_COORDINATOR_ALERT
  /// New coordinator questions for the team.
  PROJECT_COORDINATOR_QUESTION
}

/// The kind of record a notification points at.
enum NotificationEntityType {
  PROBLEM
  COMMENT
  DUPLICATE
  SYSTEM
  ALLOCATION
  RESOLUTION_ROOM
  RESOLUTION_PROJECT
}

/// One in-app notification for one person.
///
/// Rendered once, when the event happens: `title` and `message` are stored
/// rather than recomputed, so a notification reads the same tomorrow as it did
/// today even if the problem is renamed. They hold only what the recipient
/// needs — a public reference and a short phrase — never contact details.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  /// Cascade: a person's notifications are theirs alone and have no value once
  /// the account is gone.
  recipientId String @db.Uuid
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  entityType NotificationEntityType
  /// The problem, comment or pair the notification is about. No foreign key:
  /// it points at different tables by `entityType`, and a notification about a
  /// since-deleted comment should survive as history rather than vanish.
  entityId   String?                @db.Uuid

  /// Small, allow-listed navigation data — a public id, a status, a
  /// percentage. Validated on write and treated as untrusted on read.
  metadata Json? @db.JsonB

  /// Idempotency: one notification per recipient per event, enforced by the
  /// unique constraint below. A retried job, a double tap or a replayed event
  /// all produce the same key and insert nothing. See docs/ARCHITECTURE.md.
  dedupeKey String

  /// Null means unread.
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([recipientId, dedupeKey])
  /// The activity center and popover: one person's newest first, keyset-paged.
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  /// Unread count and the Unread tab: `recipientId = ? AND readAt IS NULL`.
  @@index([recipientId, readAt])
  /// Retention: purging old notifications by age across everyone.
  @@index([createdAt])
  @@map("notifications")
}

/// Who may read a note. Only INTERNAL exists: a note written by a government
/// office is visible to that office's members and nobody else. An enum rather
/// than a boolean so a later "shared with the allocated organisation" level is
/// an addition, not a reinterpretation.
enum NoteVisibility {
  INTERNAL
}

/// A government reviewer's private note on a problem (Prompt 15).
///
/// Its own table — never a column on `problems` — so no public read of a
/// problem can include one by accident. Only the government API reads it, and
/// only for members of the office that wrote it. Notes are append-only.
model ProblemInternalNote {
  id String @id @default(uuid()) @db.Uuid

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// The government office the note belongs to.
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Restrict: a note's author is part of the record.
  authorId String @db.Uuid
  author   User   @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  body       String
  visibility NoteVisibility @default(INTERNAL)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([problemId, organizationId, createdAt])
  @@map("problem_internal_notes")
}

/// Where an allocation is in its life (Prompt 16). Separate from
/// `ProblemStatus`: a problem is VERIFIED while its allocation is PENDING, and
/// becomes IN_PROGRESS only when an allocation is ACCEPTED.
///
/// PENDING → ACCEPTED | DECLINED | CANCELLED. Nothing else. EXPIRED is reserved
/// for a time limit on responses; nothing sets it yet.
enum AllocationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

/// A government office's decision to give a verified problem to an
/// organisation, and that organisation's response (Prompt 16).
///
/// Distinct from `OrganizationProblemMatch`: a match is the matching engine
/// saying an organisation *appears* relevant; an allocation is an authorised
/// official *selecting* it. Rows are never deleted — declined and cancelled
/// allocations are the history a reallocation is read against.
///
/// At most one PENDING or ACCEPTED allocation per problem, enforced by the
/// partial unique index `problem_allocations_one_active` (raw SQL, below the
/// table in the migration and in post-migrate.sql — Prisma cannot express a
/// partial index).
model ProblemAllocation {
  id String @id @default(uuid()) @db.Uuid

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)

  /// The organisation being asked to take the problem on.
  organizationId String       @db.Uuid
  organization   Organization @relation("AllocatedOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  /// The government office that allocated it.
  governmentOrganizationId String       @db.Uuid
  governmentOrganization   Organization @relation("AllocatingOffice", fields: [governmentOrganizationId], references: [id], onDelete: Restrict)

  allocatedById String @db.Uuid
  allocatedBy   User   @relation("AllocationAllocatedBy", fields: [allocatedById], references: [id], onDelete: Restrict)

  status AllocationStatus @default(PENDING)

  /// What the office asks of the organisation. Shared with the organisation.
  instructions   String?
  /// Why this organisation was chosen. Government-only.
  internalReason String?

  /// The organisation's optional note on accepting. Shared with the office.
  responseNote  String?
  /// Required on decline. Shared with the allocating office only.
  declineReason String?
  respondedById String? @db.Uuid
  respondedBy   User?   @relation("AllocationRespondedBy", fields: [respondedById], references: [id], onDelete: Restrict)

  cancellationReason String?
  cancelledById      String? @db.Uuid
  cancelledBy        User?   @relation("AllocationCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  proposedAt  DateTime  @default(now()) @db.Timestamptz(3)
  respondedAt DateTime? @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  declinedAt  DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  resolutionRoom    ResolutionRoom?
  resolutionProject ResolutionProject?

  /// A problem's allocation history, newest first.
  @@index([problemId, createdAt])
  /// An organisation's inbox.
  @@index([organizationId, status, createdAt])
  /// An office's allocations, for its dashboard.
  @@index([governmentOrganizationId, status])
  @@map("problem_allocations")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Null for system-initiated actions. SetNull so the entry survives the
  /// actor's account being removed — an audit trail that disappears with the
  /// person who acted is not an audit trail.
  actorUserId String? @db.Uuid
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Verb, e.g. `PROBLEM_CREATED`, `ROLE_CHANGED`, `ORGANIZATION_VERIFIED`.
  /// A string rather than an enum: new actions arrive with every milestone, and
  /// an enum would need a migration each time for no integrity gain here.
  action String

  /// What was acted on, e.g. `Problem` / the row's UUID.
  entityType String
  entityId   String? @db.Uuid

  /// Action-specific detail — before/after values, the reason given. JSONB
  /// because the shape genuinely differs per action.
  metadata Json? @db.JsonB

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// "Everything that happened to this record."
  @@index([entityType, entityId, createdAt])
  /// "Everything this person did."
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// Resolution rooms (Prompt 17)
// ===========================================================================

enum ResolutionRoomStatus {
  OPEN
  /// Closed by the allocating office, with a reason. Read-only.
  CLOSED
  /// Reserved for a later retention workflow. Nothing sets it yet.
  ARCHIVED
}

/// Which side of a room a participant speaks for.
enum ResolutionParticipantSide {
  GOVERNMENT
  ORGANIZATION
}

enum ResolutionRoomEventType {
  ROOM_CREATED
  PARTICIPANT_JOINED
  MESSAGE_SENT
  MESSAGE_EDITED
  MESSAGE_DELETED
  ATTACHMENT_ADDED
  ROOM_CLOSED
  // --- Project (Prompt 18): structured events, never chat -----------------
  PROJECT_CREATED
  PROJECT_UPDATED
  /// metadata: { from, to, reason? }
  PROJECT_STATUS_CHANGED
  TASK_CREATED
  TASK_UPDATED
  /// metadata: { taskId, assigneeName }
  TASK_ASSIGNED
  /// metadata: { taskId, from, to }
  TASK_STATUS_CHANGED
  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_COMPLETED
  MILESTONE_REOPENED
  // --- Coordinator (Prompt 19) --------------------------------------------
  /// A person posted a structured project update.
  PROJECT_UPDATE_POSTED
}

/// The private collaboration space between the allocating office and the
/// organisation that accepted. Opens in the same transaction as the
/// acceptance; one per accepted allocation (unique `allocationId`, and a
/// trigger that refuses a room for an allocation that is not ACCEPTED).
///
/// Participants are not stored: they are the current ACTIVE members of the two
/// organisations, resolved on every request.
model ResolutionRoom {
  id String @id @default(uuid()) @db.Uuid

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)

  allocationId String            @unique @db.Uuid
  allocation   ProblemAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  governmentOrganizationId String       @db.Uuid
  governmentOrganization   Organization @relation("RoomGovernment", fields: [governmentOrganizationId], references: [id], onDelete: Restrict)

  assignedOrganizationId String       @db.Uuid
  assignedOrganization   Organization @relation("RoomOrganization", fields: [assignedOrganizationId], references: [id], onDelete: Restrict)

  status ResolutionRoomStatus @default(OPEN)

  closedAt    DateTime? @db.Timestamptz(3)
  closedById  String?   @db.Uuid
  closedBy    User?     @relation("RoomClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  closeReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  messages    ResolutionMessage[]
  attachments ResolutionAttachment[]
  events      ResolutionRoomEvent[]
  reads       ResolutionRoomRead[]
  project     ResolutionProject?

  @@index([governmentOrganizationId, status])
  @@index([assignedOrganizationId, status])
  @@index([problemId])
  @@map("resolution_rooms")
}

/// A participant-authored message. Soft-deleted: the row and its text are
/// kept for the record, and never returned once `deletedAt` is set.
model ResolutionMessage {
  id String @id @default(uuid()) @db.Uuid

  roomId String         @db.Uuid
  room   ResolutionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  /// The organisation the author spoke for, fixed at write time.
  authorOrganizationId String                    @db.Uuid
  authorOrganization   Organization              @relation(fields: [authorOrganizationId], references: [id], onDelete: Restrict)
  authorSide           ResolutionParticipantSide

  /// Plain text. Rendered as text, never as markup.
  body String

  editedAt  DateTime? @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  mentions    ResolutionMessageMention[]
  attachments ResolutionAttachment[]

  /// Keyset pagination: newest first, ties broken by id.
  @@index([roomId, createdAt, id])
  @@map("resolution_messages")
}

/// A participant named in a message. Stored, not re-parsed from text.
model ResolutionMessageMention {
  messageId String            @db.Uuid
  message   ResolutionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([messageId, userId])
  @@index([userId])
  @@map("resolution_message_mentions")
}

/// File metadata. The bytes live in storage under a server-generated key and
/// are served only through the room's authorised endpoint.
model ResolutionAttachment {
  id String @id @default(uuid()) @db.Uuid

  roomId String         @db.Uuid
  room   ResolutionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// Null until the uploader attaches it to a message.
  messageId String?            @db.Uuid
  message   ResolutionMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  uploadedById String @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  /// Display only — sanitised, never used as a path.
  fileName   String
  /// Detected from the bytes, never the client's claim.
  mimeType   String
  size       Int
  storageKey String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tasks ResolutionTaskAttachment[]

  @@index([roomId, createdAt])
  @@index([messageId])
  @@map("resolution_attachments")
}

/// System activity in a room — never user-authored text.
model ResolutionRoomEvent {
  id String @id @default(uuid()) @db.Uuid

  roomId String         @db.Uuid
  room   ResolutionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  type ResolutionRoomEventType

  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// Ids and names only (message id, organisation name, file name).
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([roomId, createdAt])
  @@map("resolution_room_events")
}

/// Per-participant read marker, for unread counts. Created on first visit,
/// which is also when PARTICIPANT_JOINED is recorded.
model ResolutionRoomRead {
  roomId String         @db.Uuid
  room   ResolutionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  lastReadAt DateTime? @db.Timestamptz(3)
  joinedAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@id([roomId, userId])
  @@index([userId])
  @@map("resolution_room_reads")
}

// ===========================================================================
// Resolution projects (Prompt 18)
// ===========================================================================

enum ResolutionProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ResolutionTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ResolutionTaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// The structured plan for resolving one allocated problem. Created in the
/// acceptance transaction, alongside the room; one per room and allocation.
/// Problem, organisations and allocation are references, not copies.
model ResolutionProject {
  id String @id @default(uuid()) @db.Uuid

  roomId String         @unique @db.Uuid
  room   ResolutionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)

  allocationId String            @unique @db.Uuid
  allocation   ProblemAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  governmentOrganizationId String       @db.Uuid
  governmentOrganization   Organization @relation("ProjectGovernment", fields: [governmentOrganizationId], references: [id], onDelete: Restrict)

  assignedOrganizationId String       @db.Uuid
  assignedOrganization   Organization @relation("ProjectOrganization", fields: [assignedOrganizationId], references: [id], onDelete: Restrict)

  name        String
  description String?

  status ResolutionProjectStatus @default(PLANNED)

  /// Calendar dates (no time of day).
  startDate  DateTime? @db.Date
  targetDate DateTime? @db.Date

  startedAt   DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  /// Optimistic concurrency: every edit must name the version it read.
  version Int @default(1)

  createdById String @db.Uuid
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tasks      ResolutionTask[]
  milestones ResolutionMilestone[]
  insights   ProjectAIInsight[]
  questions  CoordinatorQuestion[]
  updates    ProjectUpdate[]
  knowledge  KnowledgeSource[]

  @@index([governmentOrganizationId, status])
  @@index([assignedOrganizationId, status])
  @@index([problemId])
  @@map("resolution_projects")
}

model ResolutionMilestone {
  id String @id @default(uuid()) @db.Uuid

  projectId String            @db.Uuid
  project   ResolutionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?

  /// Status is derived — completed, overdue, in progress or upcoming — from
  /// these and the milestone's tasks. Only completion is stored.
  dueDate       DateTime? @db.Date
  completedAt   DateTime? @db.Timestamptz(3)
  completedById String?   @db.Uuid
  completedBy   User?     @relation("MilestoneCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)

  version Int @default(1)

  createdById String @db.Uuid
  createdBy   User   @relation("MilestoneCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tasks ResolutionTask[]

  @@index([projectId, dueDate])
  @@map("resolution_milestones")
}

model ResolutionTask {
  id String @id @default(uuid()) @db.Uuid

  projectId String            @db.Uuid
  project   ResolutionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Optional grouping. Removing a milestone is not supported; SetNull is a guard.
  milestoneId String?              @db.Uuid
  milestone   ResolutionMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  title       String
  description String?

  status   ResolutionTaskStatus   @default(TODO)
  priority ResolutionTaskPriority @default(MEDIUM)

  /// An ACTIVE member of the assigned organisation, checked on write.
  assignedToId String? @db.Uuid
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)

  dueDate DateTime? @db.Date

  startedAt     DateTime? @db.Timestamptz(3)
  completedAt   DateTime? @db.Timestamptz(3)
  completedById String?   @db.Uuid
  completedBy   User?     @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledAt   DateTime? @db.Timestamptz(3)

  version Int @default(1)

  createdById String @db.Uuid
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  attachments ResolutionTaskAttachment[]

  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([projectId, milestoneId])
  @@index([assignedToId, status])
  @@map("resolution_tasks")
}

/// A room attachment referenced by a task. The file itself stays where it
/// was uploaded — the room's attachment store.
model ResolutionTaskAttachment {
  taskId String         @db.Uuid
  task   ResolutionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  attachmentId String               @db.Uuid
  attachment   ResolutionAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([taskId, attachmentId])
  @@index([attachmentId])
  @@map("resolution_task_attachments")
}

// ===========================================================================
// AI Project Coordinator (Prompt 19)
// ===========================================================================

/// A project-health signal — not the civic priority engine (Prompt 21).
enum ProjectHealth {
  HEALTHY
  NEEDS_ATTENTION
  AT_RISK
  BLOCKED
}

enum CoordinatorInsightStatus {
  COMPLETED
  FAILED
}

enum CoordinatorTrigger {
  MANUAL
  SCHEDULED
}

enum CoordinatorQuestionStatus {
  OPEN
  ANSWERED
  DISMISSED
  EXPIRED
}

enum ProjectUpdateSource {
  MANUAL
  /// Drafted by the coordinator from free text, then confirmed by its author.
  AI_ASSISTED
}

/// One coordinator analysis. Kept, never overwritten: the newest COMPLETED row
/// is shown; FAILED rows record that an attempt failed without touching it.
/// Findings are JSON — they are read as a unit, never queried field by field.
model ProjectAIInsight {
  id String @id @default(uuid()) @db.Uuid

  projectId String            @db.Uuid
  project   ResolutionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status  CoordinatorInsightStatus
  trigger CoordinatorTrigger

  requestedById String? @db.Uuid
  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  /// Deterministic health from the signals, and the final health after the
  /// model's (bounded) interpretation.
  baselineHealth ProjectHealth
  health         ProjectHealth?
  healthReason   String?

  summary     String?
  /// Validated, ref-cited findings.
  risks       Json?
  blockers    Json?
  suggestions Json?
  deadlines   Json?
  /// The deterministic signals the analysis was given.
  signals     Json?

  failureCode    String?
  failureMessage String?

  provider      String
  modelName     String
  modelVersion  String
  promptVersion String
  processingMs  Int?
  /// Findings the validator removed because they cited nothing real.
  droppedItems  Int    @default(0)

  /// The latest project change the analysis saw. A newer change makes it stale.
  basedOnChangeAt DateTime @db.Timestamptz(3)
  generatedAt     DateTime @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)

  questions CoordinatorQuestion[]

  @@index([projectId, status, generatedAt])
  @@map("project_ai_insights")
}

/// A question the coordinator asked the team. One OPEN question per
/// fingerprint (partial unique index); a fingerprint answered or dismissed
/// recently is not asked again.
model CoordinatorQuestion {
  id String @id @default(uuid()) @db.Uuid

  projectId String            @db.Uuid
  project   ResolutionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  insightId String?           @db.Uuid
  insight   ProjectAIInsight? @relation(fields: [insightId], references: [id], onDelete: SetNull)

  question    String
  category    String
  /// `<category>|<target ref>`, or the category and normalised text.
  fingerprint String
  targetRef   String?
  sourceRefs  Json

  status CoordinatorQuestionStatus @default(OPEN)

  askedAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  answer        String?
  answeredAt    DateTime? @db.Timestamptz(3)
  answeredById  String?   @db.Uuid
  answeredBy    User?     @relation("QuestionAnsweredBy", fields: [answeredById], references: [id], onDelete: Restrict)
  dismissedAt   DateTime? @db.Timestamptz(3)
  dismissedById String?   @db.Uuid
  dismissedBy   User?     @relation("QuestionDismissedBy", fields: [dismissedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([projectId, status, askedAt])
  @@index([projectId, fingerprint])
  @@map("coordinator_questions")
}

/// A structured progress update written — or confirmed — by a person.
model ProjectUpdate {
  id String @id @default(uuid()) @db.Uuid

  projectId String            @db.Uuid
  project   ResolutionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  authorOrganizationId String       @db.Uuid
  authorOrganization   Organization @relation(fields: [authorOrganizationId], references: [id], onDelete: Restrict)

  summary   String
  completed String[]
  current   String[]
  blockers  String[]
  nextSteps String[]

  source  ProjectUpdateSource @default(MANUAL)
  /// For AI_ASSISTED drafts: which model drafted it, for later evaluation.
  aiModel String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([projectId, createdAt])
  @@map("project_updates")
}

// ===========================================================================
// Knowledge & RAG (Prompt 20)
// ===========================================================================

enum KnowledgeSourceType {
  CIVIC_GUIDELINE
  GOVERNMENT_POLICY
  PROJECT_DOCUMENT
  PROJECT_NOTE
  PROBLEM_CONTEXT
  ORGANIZATION_DOCUMENT
  WEB_REFERENCE
  OTHER
}

/// Who may retrieve a source. Enforced in SQL before anything reaches a model.
enum KnowledgeVisibility {
  /// Every signed-in user.
  PUBLIC
  /// Active GOVERNMENT-role members of the owning office.
  GOVERNMENT
  /// Active members of the owning organisation.
  ORGANIZATION
  /// Participants of one resolution project, and only in that project's context.
  PROJECT
  /// The uploader alone.
  PRIVATE
}

enum KnowledgeIngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// A body of knowledge: a guideline, a policy, a project document. Owns its
/// documents and chunks; deleting it deletes them.
model KnowledgeSource {
  id String @id @default(uuid()) @db.Uuid

  title       String
  description String?
  sourceType  KnowledgeSourceType
  visibility  KnowledgeVisibility

  /// The owning office or organisation (who manages it; GOVERNMENT and
  /// ORGANIZATION visibility are scoped to it).
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// PROJECT visibility: the project it belongs to.
  projectId String?            @db.Uuid
  project   ResolutionProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  externalUrl String?
  /// Uploaded file: a server-generated storage key, never a client path.
  storageKey  String?
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  /// Pasted text, when there is no file.
  inlineText  String?

  /// Contextual relevance: problem categories it applies to (empty = any).
  categories ProblemCategory[]
  /// Contextual relevance: the city it is specific to, if any.
  city       String?

  status         KnowledgeIngestionStatus @default(PENDING)
  /// Caller-safe failure reason. Never a stack trace or provider detail.
  failureCode    String?
  failureMessage String?
  attempts       Int                      @default(0)

  chunkCount       Int       @default(0)
  embeddingModel   String?
  embeddingVersion String?
  chunkerVersion   String?
  ingestedAt       DateTime? @db.Timestamptz(3)

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  documents KnowledgeDocument[]
  chunks    KnowledgeChunk[]

  @@index([visibility, status])
  @@index([organizationId, visibility])
  @@index([projectId])
  @@index([uploadedById])
  @@index([status, updatedAt])
  @@map("knowledge_sources")
}

/// Extracted text of one document in a source.
model KnowledgeDocument {
  id String @id @default(uuid()) @db.Uuid

  knowledgeSourceId String          @db.Uuid
  knowledgeSource   KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  title       String
  content     String
  language    String @default("en")
  contentHash String
  pageCount   Int?
  metadata    Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  chunks KnowledgeChunk[]

  @@index([knowledgeSourceId])
  @@map("knowledge_documents")
}

/// A retrievable passage with its embedding. `sourceId` is denormalised so
/// the access filter needs one join, not two.
model KnowledgeChunk {
  id String @id @default(uuid()) @db.Uuid

  documentId String            @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sourceId String          @db.Uuid
  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  chunkIndex   Int
  content      String
  tokenCount   Int
  sectionTitle String?
  pageNumber   Int?
  contentHash  String

  /// pgvector column, written by raw SQL. The HNSW and full-text indexes live
  /// in the migration and post-migrate.sql (Prisma cannot express them).
  embedding        Unsupported("vector(384)")?
  embeddingModel   String
  embeddingVersion String
  dimensions       Int                         @default(384)

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([documentId, chunkIndex])
  @@index([sourceId])
  @@index([contentHash, embeddingModel])
  @@map("knowledge_chunks")
}

/// One RAG answer, with what is needed to reproduce and evaluate it.
model KnowledgeAnswer {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  contextType String
  problemId   String? @db.Uuid
  projectId   String? @db.Uuid

  question             String
  answer               String?
  insufficientEvidence Boolean @default(false)
  /// ANSWERED, NO_EVIDENCE or FAILED.
  status               String

  modelName         String?
  modelVersion      String?
  promptVersion     String?
  embeddingModel    String
  embeddingVersion  String
  retrievalVersion  String
  retrievedChunkIds String[] @db.Uuid
  scores            Json?
  retrievalMs       Int?
  generationMs      Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("knowledge_answers")
}
