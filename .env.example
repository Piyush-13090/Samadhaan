# ==============================================================================
# Samadhaan — environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#   cp .env.example .env
#
# One file drives all three services in development:
#   - apps/api     (NestJS)  reads it via @nestjs/config
#   - services/ai  (FastAPI) reads it via pydantic-settings
#   - apps/web     (Next.js) reads only NEXT_PUBLIC_* and server-side API vars
# ==============================================================================

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS + pgvector)
#
# Matches the credentials in docker-compose.yml. Change both together.
# PostGIS powers geographic problem search; pgvector powers semantic duplicate
# detection. Both extensions are created by infrastructure/database/init.sql.
# ------------------------------------------------------------------------------
POSTGRES_USER=samadhaan
POSTGRES_PASSWORD=samadhaan_dev_password
POSTGRES_DB=samadhaan
POSTGRES_PORT=5432
DATABASE_URL=postgresql://samadhaan:samadhaan_dev_password@localhost:5432/samadhaan?schema=public

# ------------------------------------------------------------------------------
# Redis — caching, rate limiting, background jobs, notifications, AI queues
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# NestJS API
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated browser origins permitted to call the API.
# Must match the port the Next.js dev server binds (WEB_PORT).
CORS_ORIGINS=http://localhost:3100
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Python AI service
#
# Only the NestJS API calls this. It is never exposed to the browser.
# Port 8001 rather than FastAPI's usual 8000 to avoid colliding with other
# local services; change it here and AI_SERVICE_URL together.
# ------------------------------------------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8001
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=15000
# Shared secret the API sends as `x-internal-token`. The AI service enforces it
# only when AI_INTERNAL_TOKEN is set, so it can be left blank locally.
AI_SERVICE_TOKEN=
AI_INTERNAL_TOKEN=
AI_LOG_LEVEL=debug
# Comma-separated origins allowed to call the AI service directly.
# Keep this empty in production — traffic should arrive only via the API.
AI_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Next.js frontend
#
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put a secret
# in one. The browser talks to the NestJS API and nothing else.
# Port 3100 rather than Next's usual 3000 to avoid colliding with other local
# dev servers; keep WEB_PORT and CORS_ORIGINS in sync.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Samadhaan
WEB_PORT=3100
# Base URL used by Next.js server components / route handlers. Inside Docker
# this becomes http://api:4000; on the host it matches NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:4000

# ==============================================================================
# PLACEHOLDERS — not read by any code yet. Reserved for later milestones so the
# configuration surface is known up front. Leave blank until the owning
# milestone lands.
# ==============================================================================

# --- Authentication -----------------------------------------------------------
# REQUIRED. Signing key for access-token JWTs; minimum 32 characters.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-at-least-32-chars
# Access tokens are stateless and cannot be revoked, so keep this short.
JWT_ACCESS_TTL_SECONDS=900
# Refresh tokens are revocable via the sessions table, so they can be long.
REFRESH_TTL_SECONDS=2592000
# Must be true in production (requires HTTPS). False allows local HTTP.
AUTH_COOKIE_SECURE=false
# Leave unset in development so cookies stay host-only.
AUTH_COOKIE_DOMAIN=
# Failed attempts allowed per IP+email within the window.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# DEVELOPMENT ONLY. Must be true for `npm run db:seed` to create the
# known-password test accounts. Never set this outside local development.
ALLOW_DEV_SEED=false

# --- LLM provider (AI milestones) ---------------------------------------------
# Used for multimodal problem understanding, the AI Project Coordinator and RAG.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Embeddings (duplicate detection, semantic search) ------------------------
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Must match the pgvector column dimension declared in the schema.
EMBEDDING_DIMENSIONS=1536

# --- Object storage (problem photos, completion evidence) ---------------------
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# --- Maps / geocoding (location capture) --------------------------------------
NEXT_PUBLIC_MAP_TILE_URL=
GEOCODING_API_KEY=

# --- Email / notifications ----------------------------------------------------
SMTP_URL=
EMAIL_FROM=no-reply@samadhaan.local
