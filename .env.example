# ==============================================================================
# Samadhaan — environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#   cp .env.example .env
#
# One file drives all three services in development:
#   - apps/api     (NestJS)  reads it via @nestjs/config
#   - services/ai  (FastAPI) reads it via pydantic-settings
#   - apps/web     (Next.js) reads only NEXT_PUBLIC_* and server-side API vars
# ==============================================================================

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS + pgvector)
#
# Matches the credentials in docker-compose.yml. Change both together.
# PostGIS powers geographic problem search; pgvector powers semantic duplicate
# detection. Both extensions are created by infrastructure/database/init.sql.
# ------------------------------------------------------------------------------
POSTGRES_USER=samadhaan
POSTGRES_PASSWORD=samadhaan_dev_password
POSTGRES_DB=samadhaan
POSTGRES_PORT=5432
DATABASE_URL=postgresql://samadhaan:samadhaan_dev_password@localhost:5432/samadhaan?schema=public

# ------------------------------------------------------------------------------
# Redis — caching, rate limiting, background jobs, notifications, AI queues
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# NestJS API
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated browser origins permitted to call the API.
# Must match the port the Next.js dev server binds (WEB_PORT).
CORS_ORIGINS=http://localhost:3100
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Python AI service
#
# Only the NestJS API calls this. It is never exposed to the browser.
# Port 8001 rather than FastAPI's usual 8000 to avoid colliding with other
# local services; change it here and AI_SERVICE_URL together.
# ------------------------------------------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8001
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=15000
# Shared secret the API sends as `x-internal-token`. The AI service enforces it
# only when AI_INTERNAL_TOKEN is set, so it can be left blank locally.
AI_SERVICE_TOKEN=
AI_INTERNAL_TOKEN=
AI_LOG_LEVEL=debug
# Comma-separated origins allowed to call the AI service directly.
# Keep this empty in production — traffic should arrive only via the API.
AI_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Next.js frontend
#
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put a secret
# in one. The browser talks to the NestJS API and nothing else.
# Port 3100 rather than Next's usual 3000 to avoid colliding with other local
# dev servers; keep WEB_PORT and CORS_ORIGINS in sync.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Samadhaan
WEB_PORT=3100
# Base URL used by Next.js server components / route handlers. Inside Docker
# this becomes http://api:4000; on the host it matches NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:4000

# ==============================================================================
# Feature configuration. Most of the sections below ARE read by running code —
# authentication, AI analysis, embeddings, duplicate detection and storage are
# all live. The few genuinely unused keys are marked where they appear.
# ==============================================================================

# --- Authentication -----------------------------------------------------------
# REQUIRED. Signing key for access-token JWTs; minimum 32 characters.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48-at-least-32-chars
# Access tokens are stateless and cannot be revoked, so keep this short.
JWT_ACCESS_TTL_SECONDS=900
# Refresh tokens are revocable via the sessions table, so they can be long.
REFRESH_TTL_SECONDS=2592000
# Must be true in production (requires HTTPS). False allows local HTTP.
AUTH_COOKIE_SECURE=false
# Leave unset in development so cookies stay host-only.
AUTH_COOKIE_DOMAIN=
# Failed attempts allowed per IP+email within the window.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# DEVELOPMENT ONLY. Must be true for `npm run db:seed` to create the
# known-password test accounts. Never set this outside local development.
ALLOW_DEV_SEED=false

# --- Vision-language model (problem analysis) ---------------------------------
# `anthropic` is the real provider and requires LLM_API_KEY.
#
# `development` is a keyword-matching STUB, not AI. It exists so the analysis
# pipeline can be exercised locally without an API key; it refuses to run when
# NODE_ENV=production, and its results are stored with provider="development"
# and a low confidence so they are identifiable. Never use it for anything real.
LLM_PROVIDER=development
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_TIMEOUT_SECONDS=60

# --- Embeddings (duplicate detection, semantic search) ------------------------
# `sentence-transformers` runs a real model inside the AI service. No API key,
# no per-report cost, works offline — which is what lets duplicate detection run
# on every submitted report without deduplication cost tracking report volume.
#
# The model is downloaded from Hugging Face on first use (~90 MB) and cached.
# The first request after a cold start therefore takes a few seconds.
EMBEDDING_PROVIDER=sentence-transformers
# Unused by the local provider; present for a hosted provider added later.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match BOTH the model's native width and the `vector(N)` column in
# PostgreSQL. Changing the model means a migration plus a re-embed — see
# docs/ML_DUPLICATE_DETECTION.md. The provider refuses to encode on a mismatch.
EMBEDDING_DIMENSIONS=384

# --- Duplicate detection (read by apps/api) -----------------------------------
# Starting heuristics, chosen by hand and expected to be retuned against real
# data. They live here rather than in code precisely so tuning is configuration.
# Full explanation of every value: docs/ML_DUPLICATE_DETECTION.md
#
# Distance at which geographic similarity is 0.5, and the hard retrieval cut-off.
DUPLICATE_GEO_RADIUS_METERS=750
DUPLICATE_MAX_DISTANCE_METERS=5000
# Geography and category are necessary conditions, not votes: below these floors
# they suppress the combined score rather than merely lowering it. Without them,
# identical text 500 km apart scores 0.66 and reads as a "possible duplicate".
DUPLICATE_GEO_GATE_FLOOR=0.25
DUPLICATE_CATEGORY_GATE_FLOOR=0.4
# Neighbours retrieved before scoring, and candidates stored and shown.
DUPLICATE_CANDIDATE_LIMIT=20
DUPLICATE_RESULT_LIMIT=5
DUPLICATE_MIN_TEXT_SIMILARITY=0.35
# Signal weights. Renormalised over whatever signals are actually available, so
# the absent image signal redistributes its weight rather than scoring 0.
DUPLICATE_WEIGHT_TEXT=0.35
DUPLICATE_WEIGHT_IMAGE=0.25
DUPLICATE_WEIGHT_GEO=0.25
DUPLICATE_WEIGHT_CATEGORY=0.1
DUPLICATE_WEIGHT_TEMPORAL=0.05
# Thresholds. These only decide wording and the stored row status — nothing is
# ever merged automatically, whatever the score.
DUPLICATE_HIGH_THRESHOLD=0.85
DUPLICATE_POSSIBLE_THRESHOLD=0.65
DUPLICATE_RELATED_THRESHOLD=0.5
# Age lowers a score but never rules a pair out: a pothole unrepaired for two
# years is still the same pothole when somebody reports it again.
DUPLICATE_TEMPORAL_HALF_LIFE_DAYS=120
DUPLICATE_TEMPORAL_FLOOR=0.35

# --- Object storage (problem photos, completion evidence) ---------------------
# `local` writes to STORAGE_LOCAL_ROOT and is for development only — files are
# local to one process, so a second API instance cannot read them. An S3 driver
# plugs into the same abstraction without touching problem logic.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.storage

# Public base URL of the API, used to build media URLs. Defaults to the web
# origin because the browser reaches the API through the Next.js proxy.
PUBLIC_API_URL=http://localhost:3100

# Upload limits. 8 MiB comfortably holds a modern phone photo.
UPLOAD_MAX_IMAGE_BYTES=8388608
UPLOAD_MAX_IMAGES_PER_PROBLEM=6
# How long an uploaded-but-unattached image stays claimable, in seconds.
UPLOAD_PENDING_TTL_SECONDS=3600

# Reserved for the future S3-compatible driver.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# --- Maps / geocoding ----------------------------------------------------------
# Map style (MapLibre style JSON). Defaults to OpenFreeMap, which needs no key.
# Point at your own tile server or a keyed provider's style URL in production;
# a key embedded in a *public* style URL is by definition a browser key.
NEXT_PUBLIC_MAP_STYLE_URL=
# `maplibre` renders the map; `none` shows the accessible list only.
NEXT_PUBLIC_MAP_PROVIDER=maplibre
# Where the map opens before the user picks a location: "lat,lng,zoom".
NEXT_PUBLIC_MAP_DEFAULT_VIEW=22.5,79,4

# Geocoding runs on the API, never in the browser. `none` disables search.
GEOCODING_PROVIDER=nominatim
# The public Nominatim service allows ~1 request/second and requires a real
# User-Agent; self-host it (or use a compatible provider) for production.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=
GEOCODING_USER_AGENT=Samadhaan/0.1 (development; contact: dev@samadhaan.local)
GEOCODING_COUNTRY_CODES=in
GEOCODING_TIMEOUT_MS=5000

# --- Email / notifications ----------------------------------------------------
SMTP_URL=
EMAIL_FROM=no-reply@samadhaan.local

# --- Organisation matching (Prompt 14) -------------------------------------
# Retrieval and persistence, read by the API.
MATCHING_ENABLED=true
MATCHING_CANDIDATE_LIMIT=40
MATCHING_RESULT_LIMIT=10
MATCHING_MIN_SCORE=0.35
MATCHING_CONCURRENCY=2
MATCHING_SWEEP_ON_STARTUP=true
MATCHING_SWEEP_LIMIT=200

# --- AI Project Coordinator (Prompt 19) -------------------------------------
# Advisory insights over resolution projects. Uses the same LLM_PROVIDER as
# problem analysis; with LLM_PROVIDER=development no model runs and insights
# restate the deterministic signals. See docs/AI_PROJECT_COORDINATOR.md.
COORDINATOR_ENABLED=true
COORDINATOR_SCHEDULE_MINUTES=120
COORDINATOR_MIN_INTERVAL_HOURS=12
COORDINATOR_BATCH_SIZE=10
COORDINATOR_INSIGHT_TTL_HOURS=24
COORDINATOR_REFRESH_COOLDOWN_SECONDS=120
COORDINATOR_MAX_MESSAGES=20
COORDINATOR_MAX_EVENTS=30
COORDINATOR_MAX_COMPLETED_TASKS=10
COORDINATOR_MAX_UPDATES=5
COORDINATOR_MAX_ANSWERED_QUESTIONS=10
# Health engine thresholds.
COORDINATOR_INACTIVITY_DAYS=4
COORDINATOR_DEADLINE_WINDOW_DAYS=3
COORDINATOR_AT_RISK_OVERDUE_TASKS=2
COORDINATOR_BLOCKING_PRIORITIES=HIGH,CRITICAL
COORDINATOR_MAX_OPEN_QUESTIONS=3
COORDINATOR_QUESTION_COOLDOWN_DAYS=3
COORDINATOR_QUESTION_EXPIRY_DAYS=7
# Scoring weights, read by the AI service. An initial heuristic baseline, not
# trained values. Changing any of them changes the matching version.
MATCHING_WEIGHT_SEMANTIC=0.35
MATCHING_WEIGHT_EXPERTISE=0.30
MATCHING_WEIGHT_CATEGORY=0.15
MATCHING_WEIGHT_GEOGRAPHIC=0.10
MATCHING_WEIGHT_CAPABILITY=0.05
MATCHING_WEIGHT_ACTIVITY=0.05

# --- Knowledge & RAG (Prompt 20) -------------------------------------------
# Retrieval over pgvector + PostgreSQL full-text search. Answers use the same
# LLM_PROVIDER; with LLM_PROVIDER=development no model runs and answers only
# quote the retrieved passages. See docs/RAG_ARCHITECTURE.md.
RAG_ENABLED=true
RAG_TOP_K=6
RAG_CANDIDATES=40
# Passages below this semantic similarity are dropped unless they contain at
# least half the question's terms.
RAG_SIMILARITY_THRESHOLD=0.25
RAG_WEAK_SEMANTIC=0.35
RAG_RERANK_ENABLED=true
RAG_RERANK_TOP_K=15
# Hybrid score weights — a documented baseline, not learned values.
RAG_WEIGHT_SEMANTIC=0.60
RAG_WEIGHT_KEYWORD=0.15
RAG_WEIGHT_SOURCE=0.10
RAG_WEIGHT_CONTEXT=0.10
RAG_WEIGHT_RECENCY=0.05
RAG_MAX_PASSAGE_CHARS=1500
RAG_CHUNK_MAX_TOKENS=350
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_MAX_CHUNKS_PER_SOURCE=2000
RAG_QUERY_CACHE_SECONDS=86400
RAG_COORDINATOR_TOP_K=3

# --- AI Priority Engine (Prompt 21) ----------------------------------------
# Advisory civic prioritisation for government review: an explainable
# heuristic over documented features, some AI-assisted (with confidence).
# Weights and tier thresholds are a starting baseline, NOT validated values.
# With LLM_PROVIDER=development no model runs and the AI-assisted features are
# reported as unavailable. See docs/AI_PRIORITY_ENGINE.md.
PRIORITY_ENABLED=true
PRIORITY_MODEL=heuristic
PRIORITY_AI_FEATURES_ENABLED=true
PRIORITY_WEIGHT_SEVERITY=0.20
PRIORITY_WEIGHT_URGENCY=0.15
PRIORITY_WEIGHT_COMMUNITY=0.20
PRIORITY_WEIGHT_SAFETY=0.15
PRIORITY_WEIGHT_GEOGRAPHIC=0.10
PRIORITY_WEIGHT_RECENCY=0.05
PRIORITY_WEIGHT_POPULATION=0.10
PRIORITY_WEIGHT_EVIDENCE=0.05
# Inclusive lower bounds of each tier on the 0–100 score.
PRIORITY_TIER_CRITICAL=80
PRIORITY_TIER_HIGH=60
PRIORITY_TIER_MEDIUM=35
PRIORITY_PROVISIONAL_CONFIDENCE=0.5
PRIORITY_PROVISIONAL_COMPLETENESS=0.6
PRIORITY_DEBOUNCE_SECONDS=30
PRIORITY_SCHEDULE_MINUTES=360
PRIORITY_REFRESH_HOURS=24
PRIORITY_BATCH_SIZE=200
PRIORITY_SWEEP_ON_STARTUP=true
PRIORITY_AI_REUSE_DAYS=30
PRIORITY_RECENCY_HALF_LIFE_DAYS=14
PRIORITY_NEARBY_RADIUS_M=500
PRIORITY_BASELINE_RADIUS_M=5000
PRIORITY_GUIDANCE_TOP_K=2

# --- Resolution verification (Prompt 22) -----------------------------------
# AI review of completion evidence is ADVISORY; only the allocating government
# office resolves a problem. With LLM_PROVIDER=development no model runs and no
# recommendation is claimed. See docs/RESOLUTION_VERIFICATION.md.
VERIFICATION_AI_ENABLED=true
VERIFICATION_MAX_ATTEMPTS=3
VERIFICATION_RETRY_SECONDS=60
VERIFICATION_SWEEP_ON_STARTUP=true
VERIFICATION_GUIDANCE_TOP_K=3
# Photo GPS within NEAR is consistent; beyond FAR is a potential concern.
VERIFICATION_LOCATION_NEAR_M=100
VERIFICATION_LOCATION_FAR_M=1000
VERIFICATION_IMAGE_MAX_PX=1024

# --- Impact points (Prompt 23) ---------------------------------------------
# Point values, caps and tier thresholds are versioned in code
# (apps/api/src/impact/impact-rules.ts); see docs/IMPACT_POINTS.md.
IMPACT_ENABLED=true
# Reconcile awards for verified/resolved problems (repairs lost events).
IMPACT_RECONCILE_MINUTES=60
IMPACT_RECONCILE_BATCH=200
IMPACT_RECONCILE_ON_STARTUP=true
LEADERBOARD_CACHE_SECONDS=60

# --- Civic analytics (Prompt 24) -------------------------------------------
# See docs/ANALYTICS_ARCHITECTURE.md. Dates are grouped in this IANA zone
# unless a request names another.
ANALYTICS_TIMEZONE=Asia/Kolkata
# Aggregates are cached per office, jurisdiction, period and filters.
ANALYTICS_CACHE_SECONDS=120
# AI summaries of computed metrics (generated on request only).
ANALYTICS_INSIGHTS_ENABLED=true
ANALYTICS_INSIGHT_CACHE_HOURS=6
ANALYTICS_EXPORT_MAX_ROWS=5000
