{
  "task": "problem_category",
  "dataset": "../../ml_data/problem-category/2026-10-v1",
  "artifact_dir": "ml_artifacts",
  "split": {
    "strategy": "group_random",
    "seed": 20261018,
    "validation": 0.15,
    "test": 0.15,
    "min_test_records": 150,
    "min_test_per_class": 10,
    "min_train_per_class": 30
